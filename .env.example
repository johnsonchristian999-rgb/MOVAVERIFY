# Demo mode is the only mode enabled by default.
VITE_NUMORA_MODE=demo

# Firebase web app configuration (public identifiers, not server secrets).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Configure backend secrets with Firebase Functions Secret Manager; never add them here.
# PAYSTACK_SECRET_KEY
# TWILIO_ACCOUNT_SID
# TWILIO_AUTH_TOKEN
# TWILIO_RESALE_APPROVED=false
# NUMORA_TWILIO_SMS_WEBHOOK_URL=
