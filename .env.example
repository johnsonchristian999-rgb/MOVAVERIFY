# Public Firebase Web App configuration used by the Vite client.
# Leave these blank to run the clearly labeled local demo mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server-only settings belong in Firebase Functions Secret Manager.
# Never put Paystack or Twilio secrets in this file or in Vite variables.
